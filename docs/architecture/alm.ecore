      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="definitions" upperBound="-1" eType="#//EntityRef" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Relevant versioned definitions: OutcomeGroup, Prerequisite, Strategy, LearningDesign, ProcessNode, ActivityDefinition, ResourceRequirement, Resource, AssessmentSpecification, Rubric, RuleDefinition, PolicySet and AgentSpecialization. They constitute the model catalog; shared references do not duplicate objects."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
