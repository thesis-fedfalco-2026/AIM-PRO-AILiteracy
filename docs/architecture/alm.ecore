    <eStructuralFeatures xsi:type="ecore:EReference" name="activityOccurrences" upperBound="-1" eType="#//ActivityOccurrence">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Activity occurrences in the session; node completion is derived from relevant occurrences and the node's rule."/>
      </eAnnotations>
