  <eClassifiers xsi:type="ecore:EClass" name="Prerequisite" eSuperTypes="#//Entity">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Explicit pedagogical relationship; not a dependency between workers."/>
    </eAnnotations>
    <eAnnotations source="http://alm/annotation">
      <details key="layer" value="domain_configuration"/>
      <details key="ruleRefs" value="R02 R05"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="dependent" lowerBound="1" eType="#//EntityRef" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="ActivityDefinition, ProcessNode, LearningOutcome or OutcomeGroup to which it applies."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="requiredTarget" lowerBound="1" eType="#//EntityRef" containment="true">
