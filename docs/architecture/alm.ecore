        <details key="documentation" value="Materials selected for the context."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="learningStates" upperBound="-1" eType="#//LearningState">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Learner states by outcome."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="schedule" eType="#//Text">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Actually defined dates and constraints; duration alone does not fill their absence."/>
      </eAnnotations>
