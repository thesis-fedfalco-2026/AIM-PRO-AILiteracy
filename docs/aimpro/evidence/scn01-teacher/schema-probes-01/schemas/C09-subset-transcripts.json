{
  "$defs": {
    "CorpusCitation": {
      "type": "object",
      "properties": {
        "resource_id": {
          "type": "string",
          "description": "{minLength: 1}"
        },
        "resource_version": {
          "type": "string",
          "description": "{minLength: 1}"
        },
        "document_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "{minLength: 1}"
          },
          "description": "{minItems: 1}"
        },
        "supported_claim": {
          "type": "string",
          "description": "{minLength: 1}"
        }
      },
      "additionalProperties": false,
      "required": [
        "resource_id",
        "resource_version",
        "document_ids",
        "supported_claim"
      ]
    },
    "EntityRef": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "description": "{minLength: 1}"
        },
        "id": {
          "type": "string",
          "description": "{minLength: 1}"
        },
        "version": {
          "type": "string",
          "description": "{minLength: 1}"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "version"
      ]
    },
    "PeerReference": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "description": "{const: PEER_SCENE, default: PEER_SCENE}"
        },
        "peer_key": {
          "type": "string",
          "description": "{minLength: 1}"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "peer_key"
      ]
    },
    "PromptReference": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "description": "{const: PROMPT, default: PROMPT}"
        },
        "comparison_key": {
          "type": "string",
          "description": "{minLength: 1}"
        },
        "variant": {
          "type": "string",
          "description": "{enum: ['WEAK', 'IMPROVED', 'WORSE']}"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "comparison_key",
        "variant"
      ]
    },
    "Speech": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "description": "{const: SPEECH, default: SPEECH}"
        },
        "speaker": {
          "type": "string",
          "description": "{minLength: 1}"
        },
        "text": {
          "type": "string",
          "description": "{minLength: 1}"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "speaker",
        "text"
      ]
    },
    "StructuredTeacherItem": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "description": "{minLength: 1}"
        },
        "intent": {
          "type": "string",
          "description": "{const: EXPLAIN}"
        },
        "instruction": {
          "type": "string",
          "description": "{minLength: 1}"
        },
        "outcomes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EntityRef"
          },
          "description": "{minItems: 1}"
        },
        "material_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "{minLength: 1}"
          },
          "description": "{minItems: 1}"
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CorpusCitation"
          },
          "description": "{minItems: 1}"
        }
      },
      "additionalProperties": false,
      "required": [
        "key",
        "intent",
        "instruction",
        "outcomes",
        "material_keys",
        "citations"
      ]
    },
    "StructuredTeacherUnit": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "description": "{minLength: 1}"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StructuredTeacherItem"
          },
          "description": "{maxItems: 24}\n\n{minItems: 1}"
        }
      },
      "additionalProperties": false,
      "required": [
        "key",
        "items"
      ]
    },
    "TeachingTranscript": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "description": "{minLength: 1}"
        },
        "title": {
          "type": "string",
          "description": "{minLength: 1}"
        },
        "parts": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/Speech"
              },
              {
                "$ref": "#/$defs/PromptReference"
              },
              {
                "$ref": "#/$defs/PeerReference"
              }
            ],
            "description": "{discriminator: {'mapping': {'PEER_SCENE': '#/$defs/PeerReference', 'PROMPT': '#/$defs/PromptReference', 'SPEECH': '#/$defs/Speech'}, 'propertyName': 'kind'}}"
          },
          "description": "{maxItems: 128}\n\n{minItems: 1}"
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CorpusCitation"
          },
          "description": "{minItems: 1}"
        }
      },
      "additionalProperties": false,
      "required": [
        "key",
        "title",
        "parts",
        "citations"
      ]
    }
  },
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "description": "{const: STRUCTURED_TEACHER_DRAFT, default: STRUCTURED_TEACHER_DRAFT}"
    },
    "input_digest": {
      "type": "string",
      "description": "{minLength: 1}"
    },
    "units": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/StructuredTeacherUnit"
      },
      "description": "{maxItems: 24}\n\n{minItems: 1}"
    },
    "transcripts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TeachingTranscript"
      },
      "description": "{maxItems: 24}\n\n{minItems: 1}"
    },
    "new_gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "{minLength: 1}"
      },
      "description": "{default: []}"
    }
  },
  "additionalProperties": false,
  "required": [
    "kind",
    "input_digest",
    "units",
    "transcripts",
    "new_gaps"
  ]
}
