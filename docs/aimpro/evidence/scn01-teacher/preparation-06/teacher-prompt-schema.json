{
  "$defs": {
    "CaseFact": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "label",
        "value"
      ],
      "title": "CaseFact",
      "type": "object"
    },
    "CorpusCitation": {
      "additionalProperties": false,
      "properties": {
        "resource_id": {
          "minLength": 1,
