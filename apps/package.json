{
  "name": "alm-apps",
  "version": "0.1.0",
  "private": true,
  "description": "Role applications over the ALM APIs: shared packages and one app per audience.",
  "type": "module",
  "workspaces": [
    "packages/api-client",
    "packages/ui",
    "packages/auth",
    "studio"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "npm run build --workspace @alm/studio",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces",
    "test": "vitest run",
    "generate:client": "node packages/api-client/scripts/generate.mjs",
    "check:client": "node packages/api-client/scripts/generate.mjs --check"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
